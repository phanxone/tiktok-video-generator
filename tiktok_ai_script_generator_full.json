        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"คุณคือพนักงานขายมืออาชีพบน TikTok Shop ช่วยเขียนสคริปต์และแคปชันจากสินค้านี้:\\nชื่อสินค้า: {{ $json.product_name }}\\nจุดเด่น: {{ $json.usp_highlights }}\\nกลุ่มเป้าหมาย: {{ $json.target_audience }}\\n\\nตอบเป็น JSON ดังนี้:\\n{\\n  \\\"hook_script\\\": \\\"...\\\",\\n  \\\"full_voice_script\\\": \\\"...\\\",\\n  \\\"video_title\\\": \\\"...\\\",\\n  \\\"tiktok_caption\\\": \\\"...\\\",\\n  \\\"hashtags\\\": \\\"...\\\"\\n}\"\n    }]\n  }]\n}",
        "options": {}
