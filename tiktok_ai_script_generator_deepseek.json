{
  "name": "TikTok Video Auto Generator (DeepSeek AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "trigger-node",
      "name": "Schedule Trigger (ทุก 1 ชม.)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "products",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "Pending"
            }
          ]
        }
      },
      "id": "supabase-read",
      "name": "ดึงสินค้าจาก Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_DEEPSEEK_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"คุณคือพนักงานขายมืออาชีพบน TikTok Shop ช่วยเขียนสคริปต์และแคปชันจากสินค้านี้ ตอบเป็นภาษาไทย\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"ชื่อสินค้า: {{ $json.product_name }}\\nจุดเด่น: {{ $json.usp_highlights }}\\nกลุ่มเป้าหมาย: {{ $json.target_audience }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "deepseek-ai-generator",
      "name": "DeepSeek AI เจนสคริปต์",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://tiktok-video-generator-production-e54a.up.railway.app/generate-video",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.product_name }}\",\n  \"script\": \"{{ $json.choices[0].message.content }}\"\n}",
        "options": {}
      },
      "id": "http-video-generator",
      "name": "สร้างวิดีโอ MP4 (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "products",
        "matchColumns": [
          "id"
        ],
        "fieldsToUpdate": {
          "values": [
            {
              "columnName": "status",
              "columnValue": "Video_Ready"
            }
          ]
        }
      },
      "id": "supabase-update",
      "name": "อัปเดตสถานะใน Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (ทุก 1 ชม.)": {
      "main": [
        [
          {
            "node": "ดึงสินค้าจาก Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ดึงสินค้าจาก Supabase": {
      "main": [
        [
          {
            "node": "DeepSeek AI เจนสคริปต์",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DeepSeek AI เจนสคริปต์": {
      "main": [
        [
          {
            "node": "สร้างวิดีโอ MP4 (HTTP Request)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "สร้างวิดีโอ MP4 (HTTP Request)": {
      "main": [
        [
          {
            "node": "อัปเดตสถานะใน Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
